# Copy to .env and adjust:  cp .env.example .env
# .env is git-ignored. These are LOCAL LAB values only.

# --- PostgreSQL (app database) ---
POSTGRES_USER=lab
POSTGRES_PASSWORD=lab-postgres-password
POSTGRES_DB=orders

# --- S3 / RustFS (log + trace storage) ---
S3_ENDPOINT=http://rustfs:9000
S3_ACCESS_KEY=LABACCESSKEY01
S3_SECRET_KEY=lab-rustfs-secret-key-change-me
S3_BUCKET=observability-logs
S3_REGION=us-east-1

# --- Rootprint (log/trace UI on top of Quickwit + S3) ---
ROOTPRINT_PUBLIC_URL=http://localhost:8282
ROOTPRINT_ADMIN_EMAIL=admin@lab.local
ROOTPRINT_ADMIN_PASSWORD=lab-rootprint-password
ROOTPRINT_DB_PASSWORD=lab-rootprint-db-password

# --- Grafana ---
GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=lab-grafana-password

# --- App ---
ASPNETCORE_ENVIRONMENT=Production
# /diagnostics/problem/* endpoints (always on in Development)
DIAGNOSTICS_ENABLED=true

# --- Random problems (probabilities 0..1, applied to /orders requests) ---
RANDOM_PROBLEMS_ENABLED=false
RANDOM_ERROR_RATE=0
RANDOM_EXCEPTION_RATE=0
RANDOM_SLOW_REQUEST_RATE=0
RANDOM_DB_ERROR_RATE=0
RANDOM_SLOW_DB_RATE=0
RANDOM_VERBOSE_LOG_RATE=0

# --- Host ports ---
APP_PORT=8080
GRAFANA_PORT=3000
PROMETHEUS_PORT=9090
ROOTPRINT_PORT=8282
RUSTFS_S3_PORT=9000
RUSTFS_CONSOLE_PORT=9001
